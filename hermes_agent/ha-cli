#!/bin/sh
set -eu

REAL_HA=/usr/local/lib/hermes-ha-cli/ha

# The official CLI calls its token variable SUPERVISOR_API_TOKEN; Home
# Assistant injects SUPERVISOR_TOKEN into apps that request hassio_api.
export SUPERVISOR_API_TOKEN="${SUPERVISOR_TOKEN:?SUPERVISOR_TOKEN is unavailable}"
export SUPERVISOR_ENDPOINT="${SUPERVISOR_ENDPOINT:-supervisor}"
exec "$REAL_HA" "$@"
